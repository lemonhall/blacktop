{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blacktop-api",
  "main": "src/index.mjs",

  // 正式入口走自己的 zone，而不是 `*.workers.dev`：后者在国内是**解析层就被污染**的，
  // 域名能查出来但连不上。`custom_domain: true` 意味着这条路由的 DNS 记录与证书
  // 都由 wrangler/CF 托管（部署时自动建一条 proxied 的 CNAME，不用手工去 DNS 面板加）。
  // 顺带一提：这个域名同时在提供前端（`web/` 是 assets 绑定），前后端同源、不跨域。
  "routes": [
    { "pattern": "blacktop-api.lemonhall.me", "custom_domain": true }
  ],
  // 这个日期是**本机 workerd 二进制支持的最新日期**（wrangler 4.100.0 → 2026-06-18）。
  "compatibility_date": "2026-06-18",

  // 一个 Worker 部署 = 一个后端 = 多个租户。租户信息存在 D1 里，Durable Object 的
  // 名字里带租户 id，所以"A 游戏"和"B 游戏"是两套互不可见的房间宇宙。
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      // SQLite 存储后端。这里**没有** worker_loaders 之类的付费能力，免费计划就能部署。
      "new_sqlite_classes": ["Room", "Lobby"]
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blacktop",
      // 线上库（2026-09-30 由 `wrangler d1 create blacktop` 建好，region WNAM）。
      // 本地 `wrangler dev` 用的是 .wrangler/ 下的本地副本，与这个 id 无关。
      "database_id": "67491541-37bd-45af-ac9f-b7a25b01fd04"
    }
  ],

  // 静态前端与 API 同一个 Worker：`/v1/*` 走 Worker，其余交给资源绑定。
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*"]
  },

  "observability": { "enabled": true },
  "vars": {
    "TICK_NOTE": "server-authoritative, no resident timers"
  }
}
